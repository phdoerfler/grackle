# Misc
query*.sql

# Benchmarks: generated output, not source.
# results.json is JMH's own result output (`benchmarksSql/Jmh/run`), written relative to the
# module's base directory. query-counts.json is the separate SQL query-count harness's output
# (`benchmarksSql/runMain grackle.benchmarks.sql.SqlQueryCounts`), written relative to the repo
# root instead — see that object's `outputPath` doc comment. query-sql.txt is the same harness's
# diagnostic SQL dump (see `sqlOutputPath`), same root-relative caveat. All three paths coincide
# here only because the module's base directory is itself repo-root/benchmarks-sql.
/benchmarks-sql/results.json
/benchmarks-sql/query-counts.json
/benchmarks-sql/query-sql.txt

# JMH profiler output directories (async-profiler/JFR), written into the
# module base dir when -prof is used without an explicit dir= option.
/benchmarks-sql/grackle.benchmarks.sql.*-SampleTime-depth-*/

# Benchmarks: generated output, not source. (benchmarks-orm)
# See benchmarks-sql comment block above for explanation of paths.
/benchmarks-orm/results.json
/benchmarks-orm/query-counts.json
/benchmarks-orm/grackle.benchmarks.orm.*-SampleTime-*/
