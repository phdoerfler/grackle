<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
  <persistence-unit name="adventureworks" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>grackle.benchmarks.orm.CountryRegionEntity</class>
    <class>grackle.benchmarks.orm.StateProvinceEntity</class>
    <class>grackle.benchmarks.orm.AddressEntity</class>
    <class>grackle.benchmarks.orm.BusinessEntityAddressEntity</class>
    <class>grackle.benchmarks.orm.PersonEntity</class>
    <class>grackle.benchmarks.orm.CustomerEntity</class>
    <class>grackle.benchmarks.orm.SalesOrderHeaderEntity</class>
    <class>grackle.benchmarks.orm.SalesOrderDetailEntity</class>
    <class>grackle.benchmarks.orm.ProductEntity</class>
    <class>grackle.benchmarks.orm.ProductSubcategoryEntity</class>
    <class>grackle.benchmarks.orm.ProductCategoryEntity</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5433/benchmark"/>
      <property name="jakarta.persistence.jdbc.user" value="benchmark"/>
      <property name="jakarta.persistence.jdbc.password" value="benchmark"/>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="hibernate.hbm2ddl.auto" value="none"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
      <property name="hibernate.hikari.maximumPoolSize" value="4"/>
      <property name="hibernate.hikari.minimumIdle" value="4"/>
    </properties>
  </persistence-unit>
</persistence>
